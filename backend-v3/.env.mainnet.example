# ─── backend-v3 · PRODUCTION (Base mainnet) → api.arkenia.xyz ────────────────
# Copy to .env.mainnet (gitignored) and fill. Same build as testnet — config only.

CHAIN_ID=8453
# Keyed RPC strongly recommended for a mainnet indexer (public endpoint rate-limits):
RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>
# From contracts/deployments/base.json after deployV3.mainnet.ts:
FACTORY_ADDRESS=0x20D5728912f834aD868850cdf6678C1B32692652
# Optional — deploy block; auto-discovered on first run when unset:
#START_BLOCK=

DATABASE_URL=postgresql://<user>:<pass>@localhost:5432/arkenia
PORT=3003
CORS_ORIGIN=https://arkenia.xyz
TOKEN_DECIMALS=6

# Indexer tuning (mainnet re-org buffer a touch higher):
CONFIRMATIONS=8
LOG_BLOCK_RANGE=1000
POLL_INTERVAL_MS=3000

# Cover storage — Cloudflare R2 (the existing arkenia bucket). PUT-with-cover 503s if unset.
R2_ACCOUNT_ID=<account id>
R2_ACCESS_KEY_ID=<access key>
R2_SECRET_ACCESS_KEY=<secret key>
R2_BUCKET=arkenia
R2_PUBLIC_URL=https://cdn.arkenia.xyz

LOG_LEVEL=info
