# ─── backend-v3 · TESTNET (Base Sepolia) → api-testnet.arkenia.xyz ───────────
# Copy to .env.testnet (gitignored) and fill.

CHAIN_ID=84532
# Free public RPC — no compute-unit billing (see .env.mainnet.example notes).
RPC_URL=https://sepolia.base.org
FACTORY_ADDRESS=0x3Ee587e2033149d7Dc2793daaE5af292BBe49750
#START_BLOCK=

DATABASE_URL=postgresql://<user>:<pass>@localhost:5432/arkenia_testnet
PORT=3005
CORS_ORIGIN=https://testnet.arkenia.xyz
TOKEN_DECIMALS=6

CONFIRMATIONS=5
LOG_BLOCK_RANGE=1000
POLL_INTERVAL_MS=15000

# Cover storage — optional on testnet (PUT-with-cover 503s if unset).
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_URL=

LOG_LEVEL=info
