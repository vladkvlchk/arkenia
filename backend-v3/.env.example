# ─── chain ────────────────────────────────────────────────────────────────
# Base Sepolia testnet (current). For Base mainnet: CHAIN_ID=8453 + mainnet
# factory/RPC — same build, config only.
CHAIN_ID=84532
# Prefer a keyed RPC (Alchemy/Infura); the public endpoint works but rate-limits:
# RPC_URL=https://base-sepolia.g.alchemy.com/v2/<key>
RPC_URL=https://sepolia.base.org
FACTORY_ADDRESS=0x3Ee587e2033149d7Dc2793daaE5af292BBe49750
# Factory deploy block. Optional — discovered automatically via binary search
# on first run when unset; set it to skip the discovery round-trips.
#START_BLOCK=

# ─── database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/arkenia_v3

# ─── api ──────────────────────────────────────────────────────────────────
PORT=3002
# Comma-separated origins, or * (default)
#CORS_ORIGIN=https://testnet.arkenia.xyz,http://localhost:3000

# ─── token ────────────────────────────────────────────────────────────────
# USDC / TestUSDC both use 6 decimals
TOKEN_DECIMALS=6

# ─── indexer tuning ───────────────────────────────────────────────────────
# Blocks kept behind head (re-org buffer)
CONFIRMATIONS=5
# Max blocks per eth_getLogs range (public Base RPC caps at 1000)
LOG_BLOCK_RANGE=1000
POLL_INTERVAL_MS=3000

# ─── cover storage (Cloudflare R2) — optional; PUT with cover 503s if unset ─
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_URL=https://cdn.example.com

# ─── misc ─────────────────────────────────────────────────────────────────
# 5 MiB
MAX_COVER_BYTES=5242880
LOG_LEVEL=info
