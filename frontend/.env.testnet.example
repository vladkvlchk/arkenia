# CampaignV3 public testnet (Base Sepolia, chainId 84532)
# Copy into the testnet Vercel deployment's env (or .env.local for local testnet dev).
# Absence of NEXT_PUBLIC_CHAIN_ID => app defaults to Base mainnet, so prod is unaffected.

NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Deployed 2026-07-07 (deployments/baseSepolia.json)
NEXT_PUBLIC_FACTORY_ADDRESS=0xC65b2eC7b07c9CffFBdb00D02475afaF449F9d28
NEXT_PUBLIC_TOKEN_ADDRESS=0xf586Cb41F0A87A2F37FA4acAc4C09Ea6d27fA53e

# Testnet backend (separate pm2 process + DB on the same EC2)
NEXT_PUBLIC_API_URL=https://api-testnet.arkenia.xyz/api
NEXT_PUBLIC_AUTH_URL=https://api-testnet.arkenia.xyz/api

# Privy — reuse the prod app id or provision a separate one for testnet
NEXT_PUBLIC_PRIVY_APP_ID=
