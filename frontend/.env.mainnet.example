# CampaignV3 production (Base mainnet, chainId 8453) → arkenia.xyz
# Copy into the mainnet Vercel deployment's env. NEXT_PUBLIC_* are exposed to the browser.
# Faucet, testnet banner and the "no real funds" notice auto-hide when chain != 84532.

NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_RPC_URL=https://base-mainnet.g.alchemy.com/v2/<key>   # use a keyed RPC, not the public one
NEXT_PUBLIC_EXPLORER_URL=https://basescan.org

# From contracts/deployments/base.json after `deployV3.mainnet.ts`. Token = canonical USDC.
NEXT_PUBLIC_FACTORY_ADDRESS=<CampaignV3Factory from base.json>
NEXT_PUBLIC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_TOKEN_SYMBOL=USDC

# Production V3 backend (separate pm2 process + DB on EC2, behind nginx).
NEXT_PUBLIC_API_URL=https://api.arkenia.xyz/api

# Privy — DEDICATED production app (allowed domain: arkenia.xyz). App IDs are public.
NEXT_PUBLIC_PRIVY_APP_ID=<mainnet privy app id>
